{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wowai.local/contracts/v2/assistant-request.schema.json",
  "title": "AssistantRequestV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "conversationId",
    "createdAt",
    "mode",
    "locale",
    "gameFlavor",
    "question",
    "character",
    "images",
    "observations",
    "privacy",
    "client",
    "runtime"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "requestId": { "$ref": "#/$defs/uuid" },
    "conversationId": { "$ref": "#/$defs/uuid" },
    "createdAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "mode": { "enum": ["achievement", "mount", "pet", "gear", "general", "coach"] },
    "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
    "gameFlavor": { "const": "retail" },
    "question": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "realm", "name", "classId", "specializationId", "level"],
      "properties": {
        "region": { "enum": ["cn", "us", "eu", "kr", "tw"] },
        "realm": { "type": ["string", "null"], "maxLength": 128 },
        "name": { "type": ["string", "null"], "maxLength": 128 },
        "classId": { "type": ["integer", "null"], "minimum": 1 },
        "specializationId": { "type": ["integer", "null"], "minimum": 1 },
        "level": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 }
      }
    },
    "images": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mimeType",
          "captureScope",
          "sha256",
          "dataBase64",
          "privacyMaskApplied",
          "userConfirmed",
          "uploadDestination",
          "uploadPurpose",
          "uploadConfirmedAt",
          "consentNoticeVersion"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/uuid" },
          "mimeType": { "const": "image/png" },
          "captureScope": { "enum": ["wow-window", "selected-region", "tooltip"] },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "dataBase64": {
            "type": "string",
            "minLength": 12,
            "maxLength": 956000,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          },
          "privacyMaskApplied": { "type": "boolean" },
          "userConfirmed": { "const": true },
          "uploadDestination": {
            "enum": ["openai", "deepseek", "xai", "openrouter", "dashscope", "azure-openai"]
          },
          "uploadPurpose": { "const": "visual-question" },
          "uploadConfirmedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
          "consentNoticeVersion": { "const": 1 }
        }
      }
    },
    "visualBridge": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "source",
        "sequence",
        "capturedAt",
        "confidence",
        "allowedFields",
        "unavailableFields"
      ],
      "properties": {
        "protocolVersion": { "const": 1 },
        "source": { "const": "plugin-public" },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "capturedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "allowedFields": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/bridgeField" }
        },
        "unavailableFields": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/bridgeField" }
        }
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "kind", "capturedAt", "confidence", "summary"],
        "properties": {
          "id": { "$ref": "#/$defs/uuid" },
          "source": {
            "enum": ["plugin-public", "profile-cache", "screen-observed", "model-inferred"]
          },
          "kind": {
            "enum": ["build", "game-state", "achievement-progress", "combat-ui", "screen-text"]
          },
          "capturedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedWindowOnly", "screenObservationEnabled", "rawFramesPersisted"],
      "properties": {
        "selectedWindowOnly": { "const": true },
        "screenObservationEnabled": { "type": "boolean" },
        "rawFramesPersisted": { "const": false }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addonVersion", "companionVersion", "uiScale"],
      "properties": {
        "addonVersion": { "type": ["string", "null"], "maxLength": 64 },
        "companionVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "uiScale": { "type": ["number", "null"], "minimum": 0.5, "maximum": 4 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "provider", "model", "allowCloudUpload"],
      "properties": {
        "engine": { "const": "codex" },
        "provider": {
          "enum": [
            "local-ollama",
            "local-lmstudio",
            "openai",
            "deepseek",
            "xai",
            "openrouter",
            "dashscope",
            "azure-openai",
            "mock"
          ]
        },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "allowCloudUpload": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "enum": ["openai", "deepseek", "xai", "openrouter", "dashscope", "azure-openai"]
              }
            },
            "required": ["provider"]
          },
          "then": { "properties": { "allowCloudUpload": { "const": true } } },
          "else": { "properties": { "allowCloudUpload": { "const": false } } }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "images": { "minItems": 1 } }, "required": ["images"] },
      "then": {
        "properties": {
          "runtime": {
            "properties": {
              "provider": {
                "enum": ["openai", "deepseek", "xai", "openrouter", "dashscope", "azure-openai"]
              },
              "allowCloudUpload": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": { "properties": { "provider": { "const": "openai" } } }
        }
      },
      "then": {
        "properties": {
          "images": {
            "items": { "properties": { "uploadDestination": { "const": "openai" } } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": { "properties": { "provider": { "const": "deepseek" } } }
        }
      },
      "then": {
        "properties": {
          "images": {
            "items": { "properties": { "uploadDestination": { "const": "deepseek" } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "runtime": { "properties": { "provider": { "const": "xai" } } } } },
      "then": {
        "properties": {
          "images": { "items": { "properties": { "uploadDestination": { "const": "xai" } } } }
        }
      }
    },
    {
      "if": {
        "properties": { "runtime": { "properties": { "provider": { "const": "openrouter" } } } }
      },
      "then": {
        "properties": {
          "images": {
            "items": { "properties": { "uploadDestination": { "const": "openrouter" } } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "runtime": { "properties": { "provider": { "const": "dashscope" } } } }
      },
      "then": {
        "properties": {
          "images": { "items": { "properties": { "uploadDestination": { "const": "dashscope" } } } }
        }
      }
    },
    {
      "if": {
        "properties": { "runtime": { "properties": { "provider": { "const": "azure-openai" } } } }
      },
      "then": {
        "properties": {
          "images": {
            "items": { "properties": { "uploadDestination": { "const": "azure-openai" } } }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "bridgeField": {
      "enum": [
        "class",
        "classId",
        "specialization",
        "specializationId",
        "level",
        "zone",
        "mapId",
        "activity",
        "encounterId",
        "achievementId",
        "criteria",
        "event",
        "skills",
        "talents",
        "actionSlots",
        "keyBindings"
      ]
    }
  }
}
