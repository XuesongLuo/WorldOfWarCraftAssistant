{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wowai.local/contracts/v2/assistant-response.schema.json",
  "title": "AssistantResponseV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "status",
    "mode",
    "answer",
    "sources",
    "provenance",
    "usage",
    "error"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "requestId": { "type": "string", "format": "uuid" },
    "status": { "enum": ["completed", "needs_context", "refused", "failed"] },
    "mode": { "enum": ["achievement", "mount", "pet", "gear", "general", "coach"] },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "nextSteps", "constraints", "uncertainties", "followUp"],
      "properties": {
        "summary": { "type": "string", "maxLength": 8000 },
        "nextSteps": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "constraints": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "uncertainties": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "followUp": { "type": ["string", "null"], "maxLength": 1000 }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "dataVersion"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 256 },
          "url": { "type": ["string", "null"], "pattern": "^https://" },
          "dataVersion": { "type": ["string", "null"], "maxLength": 128 }
        }
      }
    },
    "provenance": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observationId", "source", "confidence", "reason"],
        "properties": {
          "observationId": { "type": "string", "format": "uuid" },
          "source": {
            "enum": ["plugin-public", "profile-cache", "screen-observed", "model-inferred"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imageUsed",
        "knowledgeUsed",
        "screenObservationUsed",
        "addonBridgeUsed",
        "runtime",
        "provider"
      ],
      "properties": {
        "imageUsed": { "type": "boolean" },
        "knowledgeUsed": { "type": "boolean" },
        "screenObservationUsed": { "type": "boolean" },
        "addonBridgeUsed": { "type": "boolean" },
        "runtime": { "const": "codex" },
        "provider": { "enum": ["local-ollama", "local-lmstudio", "openai", "mock"] }
      }
    },
    "error": { "oneOf": [{ "type": "null" }, { "$ref": "error.schema.json" }] }
  }
}
