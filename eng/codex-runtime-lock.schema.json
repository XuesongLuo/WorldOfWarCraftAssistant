{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wowai.local/schemas/codex-runtime-lock.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "version", "source", "sha256", "appServerSchema"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "codex-cli" },
    "version": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "tarball", "integrity", "license"],
      "properties": {
        "package": { "const": "@openai/codex" },
        "version": { "type": "string", "minLength": 1 },
        "tarball": { "type": "string", "format": "uri" },
        "integrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$" },
        "license": { "const": "Apache-2.0" }
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "appServerSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
